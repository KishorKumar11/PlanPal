generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id @default(cuid())
  name            String?
  email           String        @unique
  emailVerified   DateTime?
  image           String?
  mbtiType        String?
  archetype       String?
  traitScores     Json?
  interests       String[]
  quizCompletedAt DateTime?
  quizUpdatedAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  accounts        Account[]
  memberships     GroupMember[]
  sessions        Session[]
  votes           Vote[]
  availabilities  Availability[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PlanStatus {
  idle
  voting
  locked
}

model VibeGroup {
  id                     String           @id @default(cuid())
  name                   String
  description            String?
  inviteCode             String           @unique @default(cuid())
  createdById            String
  planStatus             PlanStatus       @default(idle)
  lockedRecommendationId String?
  currentRecBatchId      String?
  dateWindowStart        DateTime?
  dateWindowEnd          DateTime?
  lockedDate             DateTime?
  planNotes              String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  members                GroupMember[]
  recommendations        Recommendation[]
  availabilities         Availability[]
  plans                  Plan[]
}

model GroupMember {
  id                    String    @id @default(cuid())
  groupId               String
  userId                String
  role                  String    @default("member")
  joinedAt              DateTime  @default(now())
  availabilitySubmittedAt DateTime?
  group                 VibeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Availability {
  id      String    @id @default(cuid())
  groupId String
  userId  String
  date    DateTime
  group   VibeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, date])
}

model Plan {
  id          String    @id @default(cuid())
  groupId     String
  title       String
  category    String
  description String
  reasoning   String
  metadata    Json?
  lockedDate  DateTime?
  notes       String?
  completedAt DateTime  @default(now())
  group       VibeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id          String    @id @default(cuid())
  groupId     String
  batchId     String?
  title       String
  description String
  category    String
  reasoning   String
  metadata    Json?
  createdAt   DateTime  @default(now())
  group       VibeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  votes       Vote[]
}

model Vote {
  id               String         @id @default(cuid())
  recommendationId String
  userId           String
  value            Int
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recommendationId, userId])
}
